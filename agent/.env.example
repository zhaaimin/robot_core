# Source this file in the container shell; the application does not load it.
# Set a model that supports Chat Completions tool calling.
ROBOT_AGENT_MODEL=
OPENAI_API_KEY=

# Optional: compatible API endpoint, including its /v1 path when required.
OPENAI_BASE_URL=

# Optional: choose a writable persistent state directory.
ROBOT_AGENT_DATA_DIR=

# Optional: CC backend connection. Native SDK remains deployment-specific.
CC_API_ID=
CC_API_ADDRESS=
CC_API_TOKEN=
